# ==============================================================================
# Variables de entorno — [NOMBRE_DEL_PROYECTO]
# ==============================================================================
# Copia este archivo a `.env` y completa los valores para tu entorno.
#   cp .env.example .env
#
# NUNCA subas tu archivo `.env` con valores reales al repositorio.
# Los valores reales viven en tu gestor de credenciales y este `.env` se genera desde ahí
# (`bw get` / `bws run`). Ver SECURITY.md y docs/conventions/secrets.md.
# ==============================================================================

# ── Entorno ───────────────────────────────────────────────────────────────
# Entorno de ejecución: development | production
# (no hay staging: `develop` es el entorno de integración — docs/conventions/deploy.md)
APP_ENV=development
# Puerto en el que escucha la aplicación
PORT=3000

# ── Base de datos ─────────────────────────────────────────────────────────
# Base de datos (registra el motor en docs/architecture/stack.md)
DATABASE_URL=

# ── Autenticación ─────────────────────────────────────────────────────────
# Secreto para firmar tokens/sesiones (genera uno aleatorio y largo)
AUTH_SECRET=
# Tiempo de expiración de los tokens
AUTH_TOKEN_TTL=7d

# ── IA ────────────────────────────────────────────────────────────────────
# El marco NO fija proveedor por defecto: se elige por producto y se registra en
# docs/architecture/stack.md. Cambiar de proveedor debe ser cambiar estas tres
# variables — si hace falta tocar código, la capa adaptadora no está haciendo su
# trabajo. Una capacidad genérica (texto, embeddings) es portable; una exclusiva no.
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
# Segundo proveedor, configurado desde el día 1 y con los tests corriendo contra
# él. Si nunca lo has ejecutado, no eres portable: solo lo crees.
AI_PROVIDER_FALLBACK=
AI_API_KEY_FALLBACK=

# ── Servicios transversales ───────────────────────────────────────────────
# UNA VARIABLE POR CATEGORÍA, no por proveedor: la plantilla no elige tus
# servicios. Renombra cada una con el proveedor que elijas en
# docs/architecture/stack.md (p. ej. PAYMENTS_API_KEY → <TUPROVEEDOR>_API_KEY),
# descomenta solo las que este producto tenga contratadas de verdad, y refléjalo
# en docs/architecture/stack.md.
# PAYMENTS_API_KEY=          # pagos
# PAYMENTS_WEBHOOK_SECRET=   # verificar la firma sobre el cuerpo crudo
# EMAIL_API_KEY=             # email transaccional
# STORAGE_ACCESS_KEY_ID=     # almacenamiento de archivos (S3-compatible)
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=          # endpoint del servicio S3-compatible
# ERROR_TRACKING_DSN=        # errores
# ANALYTICS_API_KEY=         # analytics de producto
# ANALYTICS_PERSONAL_API_KEY= # API key PERSONAL — solo si la usa un MCP (.mcp.json)

# ── Backups (scripts/backup-db.sh) ────────────────────────────────────────
# Dump diario de la base de datos a un bucket S3-compatible. El bucket de backups
# es DISTINTO del de archivos de la app: un borrado accidental en uno no puede
# llevarse el otro.
# BACKUP_S3_ENDPOINT=        # endpoint del servicio S3-compatible
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_BUCKET=          # p. ej. miapp-backups
# BACKUP_PREFIX=db           # prefijo dentro del bucket
# BACKUP_RETENTION_DAYS=30   # días que se conservan los dumps

# ── Otras APIs ────────────────────────────────────────────────────────────
# Toda API de terceros va detrás de un adaptador propio: la lógica de negocio
# no conoce al proveedor.
API_KEY=
API_URL=

# ── Logging ───────────────────────────────────────────────────────────────
# Nivel de log: debug | info | warn | error
LOG_LEVEL=info

# ── Otras variables ───────────────────────────────────────────────────────
# Añade aquí lo que este producto necesite y documenta para qué sirve cada una.
