#!/usr/bin/env bash
# pre-push — corre en local los mismos checks que el job `Calidad` del CI.
#
# Por qué: en un repositorio privado los minutos de GitHub Actions son finitos, y
# descubrir en el CI un enlace roto cuesta un run entero. Estos checks tardan ~15
# segundos aquí y no cuestan nada, así que el CI deja de ser el bucle de
# verificación y pasa a ser la red de seguridad.
#
# Este hook SÍ bloquea (al revés que pre-commit): un enlace roto o un test en rojo
# no es ruido de formato, es algo que hay que arreglar antes de publicar.
#
# Activación (una vez por clon, no se versiona en .git/config):
#   git config core.hooksPath .githooks
#
# Saltárselo puntualmente: git push --no-verify
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 0

# Sin los scripts (proyecto que los borró al instanciar), no hay nada que hacer.
[ -d .github/scripts ] || exit 0

# Cada entrada: "etiqueta<TAB>comando". Mismo orden que .github/workflows/quality.yml.
CHECKS=(
	"Formato (Prettier)	.github/scripts/format.sh --check"
	"Enlaces internos	.github/scripts/check-links.sh"
	"Placeholders	.github/scripts/check-placeholders.sh"
	"Herencia de la plantilla	.github/scripts/check-inheritance.sh"
	"Design system	.github/scripts/check-design-tokens.sh"
	"Instrucciones del README	.github/scripts/check-instructions.sh"
	"Suite de la plantilla	.github/scripts/tests/run-tests.sh"
	"Pruebas del proyecto	.github/scripts/check-project-tests.sh"
)

echo "pre-push: verificando lo mismo que el CI…" >&2
fallos=()
salida="$(mktemp)"
trap 'rm -f "$salida"' EXIT

for entrada in "${CHECKS[@]}"; do
	etiqueta="${entrada%%$'\t'*}"
	comando="${entrada#*$'\t'}"
	script="${comando%% *}"

	# Un script que ya no exista no es un fallo: el proyecto pudo podarlo.
	[ -f "$script" ] || continue

	# No cortamos en el primer fallo — igual que el `!cancelled()` del workflow,
	# para ver todos los problemas de una vez y no de uno en uno.
	if bash $comando > "$salida" 2>&1; then
		printf '  ✅ %s\n' "$etiqueta" >&2
	else
		printf '  ❌ %s\n' "$etiqueta" >&2
		sed 's/^/       /' "$salida" | tail -8 >&2
		fallos+=("$etiqueta")
	fi
done

if [ "${#fallos[@]}" -gt 0 ]; then
	echo >&2
	echo "pre-push: ${#fallos[@]} check(s) en rojo — el push se detiene aquí." >&2
	printf '   · %s\n' "${fallos[@]}" >&2
	echo >&2
	echo "   Arréglalos y vuelve a empujar. La salida de emergencia existe" >&2
	echo "   ('git push --no-verify'), pero desactiva TODOS los checks de la lista de" >&2
	echo "   arriba a la vez — y si el CI no está corriendo (minutos agotados, repo" >&2
	echo "   privado), este hook es el único filtro que queda: nadie más va a avisar." >&2
	echo "   Si el fallo parece un falso positivo del propio check, lo que toca es" >&2
	echo "   arreglar el check (y llevarlo a la plantilla), no saltárselo." >&2
	exit 1
fi

echo "pre-push: todo verde." >&2
exit 0
